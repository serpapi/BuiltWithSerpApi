---
layout: base.njk
pagination:
  data: events
  size: 1
  alias: projectForEvent
permalink: "/events/{{ projectForEvent | slug }}/"
eleventyComputed:
  title: "{{ projectForEvent }} projects | #BuiltWithSerpApi"
  description: "Browse community projects from {{ projectForEvent }}, built with SerpApi."
---

{% set filterProjects = projects | projectsByEvent(projectForEvent) %}
{% set showEventFilter = false %}

<section class="browse-hero">
  <div class="shell">
    <a class="back-link event-browse-link" href="{{ '/events/' | url }}">All events</a>
    <h1>{{ projectForEvent }}</h1>
    <p>{{ filterProjects | length }} projects from this event.</p>
  </div>
</section>

{% include "catalog-toolbar.njk" %}

<section class="stream-section">
  <div class="shell stream-layout">
    <div class="stream-header">
      <h2>Projects</h2>
      <p class="project-result-count" data-project-result-count aria-live="polite">{{ filterProjects | length }} projects</p>
    </div>
    <div id="project-feed" class="feed stream-feed" data-project-feed>
      {% set enableProjectSort = true %}
      {% for project in filterProjects | sortProjectsNewest %}
        {% set projectFeedIndex = loop.index0 %}
        {% include "project-card.njk" %}
      {% endfor %}
    </div>
    {% include "catalog-results-controls.njk" %}
  </div>
</section>
