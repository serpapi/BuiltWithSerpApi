---
layout: base.njk
pagination:
  data: events
  size: 1
  alias: projectForEvent
permalink: "/events/{{ projectForEvent | slug }}/"
eleventyComputed:
  title: "{{ projectForEvent }} projects | #BuiltWithSerpApi"
  description: "Browse community projects from {{ projectForEvent }}, built with SerpApi."
---

<section class="browse-hero">
  <div class="shell">
    <a class="back-link event-browse-link" href="{{ '/events/' | url }}">All events</a>
    <h1>{{ projectForEvent }}</h1>
    <p>{{ projects | projectsByEvent(projectForEvent) | length }} projects from this event.</p>
  </div>
</section>

<section class="shell listing">
  {% for project in projects | projectsByEvent(projectForEvent) | sortProjectsNewest %}
    {% include "project-card.njk" %}
  {% endfor %}
</section>
