---
layout: base.njk
title: "Projects Built with SerpApi | #BuiltWithSerpApi"
description: "Browse SerpApi powered apps, agents, dashboards, monitors, and experiments built by the community."
---

{% set filterProjects = projects %}
{% set showEventFilter = true %}
{% include "catalog-toolbar.njk" %}

<section class="stream-section">
  <div class="shell stream-layout">
    <header class="catalog-intro">
      <h1>#BuiltWithSerpApi</h1>
      <p>Explore community projects and find your next idea to build using SerpApi.</p>
    </header>
    <div class="catalog-stats" aria-label="Catalog statistics">
      <a href="#project-feed"><strong>{{ projects.length }}</strong> projects</a>
      <a href="{{ '/apis/' | url }}"><strong>{{ apis.length }}</strong> engines</a>
      <a href="{{ '/tags/' | url }}"><strong>{{ tags.length }}</strong> tags</a>
    </div>
    <div class="catalog-actions">
      <nav class="catalog-browse" aria-label="Browse projects">
        <a class="button button-secondary" href="{{ '/events/' | url }}">{% icon "calendar" %}All events</a>
        <a class="button button-secondary" href="{{ '/tags/' | url }}">{% icon "tag" %}All tags</a>
        <a class="button button-secondary" href="{{ '/apis/' | url }}">{% icon "api" %}All engines</a>
      </nav>
      <a class="button" href="{{ site.submitUrl }}" target="_blank" rel="noopener noreferrer">{% icon "send" %}Submit your project</a>
    </div>
    <div class="stream-header">
      <h2>Project ideas</h2>
      <p class="project-result-count" data-project-result-count aria-live="polite">{{ projects.length }} projects</p>
    </div>

    <div id="project-feed" class="feed stream-feed" data-project-feed>
    {% set feedProjects = projects | sortProjectsNewest %}
    {% set enableProjectSort = true %}
    {% for project in feedProjects %}
      {% set projectFeedIndex = loop.index0 %}
      {% include "project-card.njk" %}
    {% endfor %}
    </div>

    <template data-promo-pool>
      {% for promo in promos %}
        {% include "resource-promo.njk" %}
      {% endfor %}
    </template>

    {% include "catalog-results-controls.njk" %}

  </div>
</section>
