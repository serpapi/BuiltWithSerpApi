<article class="project-card{% if project.featured %} project-card-featured{% endif %}"{% if enableProjectSort %} data-feed-item="project" data-project-date="{{ project.dateAdded | escape }}" data-project-title="{{ project.name | escape }}" data-project-order="{{ projectFeedIndex }}" data-project-tags="{{ project | projectTags | encodeFacetValues }}" data-project-events="{{ project | projectEvents | encodeFacetValues }}" data-project-apis="{{ project.apis | encodeFacetValues }}"{% endif %}>
  <div class="project-kicker">
    <span>
      {% if project.featured %}
        {% icon "star" %}Featured example
      {% else %}
        {% icon "bolt" %}Built with SerpApi
      {% endif %}
    </span>
    <span>{% icon "hub" %}{{ project.apis | length }} engine{% if project.apis | length != 1 %}s{% endif %}</span>
  </div>
  <div class="project-card-top">
    <div>
      <h2><a href="{{ (project | projectPermalink) | url }}">{{ project.name }}</a></h2>
      <p class="author">by {{ project.author }}</p>
    </div>
  </div>

  <p class="project-description">{{ project.description }}</p>

  {% set projectEventNames = project | projectEvents %}
  {% if projectEventNames.length %}
    <div class="event-row" aria-label="Project events">
      <span class="event-label">Events</span>
      {% for event in projectEventNames %}
        <a class="chip event-chip" href="{{ ('/events/' + (event | slug) + '/') | url }}">{% icon "calendar" %}{{ event }}</a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="meta-group" aria-label="Project tags">
    {% for tag in project | projectTags %}
      <a class="chip" href="{{ ('/tags/' + (tag | slug) + '/') | url }}">{% icon "tag" %}{{ tag }}</a>
    {% endfor %}
  </div>

  <div class="api-row" aria-label="SerpApi APIs used">
    {% for api in project.apis %}
      <a class="api-pill" href="{{ ('/apis/' + (api | slug) + '/') | url }}">{% icon "api" %}{{ api }}</a>
    {% endfor %}
  </div>

  <div class="project-links">
    <a href="{{ (project | projectPermalink) | url }}">{% icon "feed" %}Project details</a>
    {% if project.hostedUrl %}
      <a class="primary-project-link" href="{{ project.hostedUrl }}" target="_blank" rel="noopener noreferrer">{% icon "rocket" %}Open project</a>
    {% endif %}
    <a href="{{ project.githubUrl }}" target="_blank" rel="noopener noreferrer">{% icon "github" %}View source</a>
    {% for link in project.links %}
      <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{% icon "link" %}{{ link.label }}</a>
    {% endfor %}
  </div>
</article>
