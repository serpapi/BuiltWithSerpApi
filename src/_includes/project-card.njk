{% set projectEventNames = project | projectEvents %}
<article class="project-card{% if project.featured %} project-card-featured{% endif %}"{% if enableProjectSort %} data-feed-item="project" data-project-date="{{ project.dateAdded | escape }}" data-project-search="{{ (project.name ~ ' ' ~ project.author ~ ' ' ~ project.description) | escape }}" data-project-title="{{ project.name | escape }}" data-project-order="{{ projectFeedIndex }}" data-project-tags="{{ project | projectTags | encodeFacetValues }}" data-project-events="{{ project | projectEvents | encodeFacetValues }}" data-project-apis="{{ project.apis | encodeFacetValues }}"{% endif %}>
  <div class="project-kicker">
    <span class="project-kicker-title{% if project.featured %} project-featured-label{% endif %}">
      {% if project.featured %}
        {% icon "star" %}Featured example
      {% else %}
        {% icon "bolt" %}Built with SerpApi
      {% endif %}
    </span>
    {% if projectEventNames.length %}
      <div class="project-kicker-events">
        {% for event in projectEventNames %}
          <a class="chip event-chip" href="{{ ('/events/' + (event | slug) + '/') | url }}">{% icon "calendar" %}{{ event }}</a>
        {% endfor %}
      </div>
    {% else %}
      <span class="project-engine-count">{% icon "api" %}{{ project.apis | length }} engine{% if project.apis | length != 1 %}s{% endif %}</span>
    {% endif %}
  </div>
  <div class="project-card-top">
    <div>
      <h2><a href="{{ (project | projectPermalink) | url }}">{{ project.name }}</a></h2>
      <p class="author">by {{ project.author }}</p>
    </div>
  </div>

  <p class="project-description">{{ project.description }}</p>

  <div class="meta-group" aria-label="Project tags">
    {% for tag in project | projectTags %}
      <a class="chip" href="{{ ('/tags/' + (tag | slug) + '/') | url }}">{% icon "tag" %}{{ tag }}</a>
    {% endfor %}
  </div>

  <div class="api-row" aria-label="SerpApi APIs used">
    {% for api in project.apis %}
      <a class="api-pill" href="{{ ('/apis/' + (api | slug) + '/') | url }}">{% icon "api" %}{{ api }}</a>
    {% endfor %}
  </div>

  <div class="project-links">
    <div class="project-actions">
      <a href="{{ (project | projectPermalink) | url }}">{% icon "details" %}Project details</a>
      {% if project.hostedUrl %}
        <a href="{{ project.hostedUrl }}" target="_blank" rel="noopener noreferrer">{% icon "open" %}Open project</a>
      {% endif %}
      <a href="{{ project.githubUrl }}" target="_blank" rel="noopener noreferrer">{% icon "github" %}View source</a>
    </div>
    {% if project.links and project.links.length %}
      <div class="project-submission-links">
        {% for link in project.links %}
          <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{% icon "link" %}{{ link.label }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</article>
